# Строка подключения к PostgreSQL. Для локальной разработки и для продакшена — один и тот же
# формат: возьмите бесплатную базу на https://neon.com (или Supabase/Vercel Postgres), скопируйте
# connection string оттуда и вставьте сюда.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи сессий NextAuth — для продакшена сгенерируйте случайную строку, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-random-secret-in-production"

# Адрес, на котором крутится приложение. Локально — localhost, на Vercel — ваш домен вида
# https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"
