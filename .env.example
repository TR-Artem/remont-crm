# Строка подключения к PostgreSQL. Для локальной разработки и для продакшена — один и тот же
# формат: возьмите бесплатную базу на https://neon.com (или Supabase/Vercel Postgres), скопируйте
# connection string оттуда и вставьте сюда.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи сессий NextAuth — для продакшена сгенерируйте случайную строку, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-random-secret-in-production"

# Адрес, на котором крутится приложение. Локально — localhost, на Vercel — ваш домен вида
# https://your-project.vercel.app. На Vercel можно не задавать: домен подставляется сам
# (в lib/auth.config.ts включён trustHost).
NEXTAUTH_URL="http://localhost:3000"

# Хранилище фото к закрытию заявки (Vercel Blob). На Vercel без токена загрузка фото вернёт
# ошибку 503, а статус «Готово» требует фото. Включите: Vercel → Storage → Create → Blob
# (или `npx vercel storage create remont-crm-uploads --type blob --access public`), затем
# `npx vercel env pull` или скопируйте токен из настроек проекта.
# Локально токен не нужен: файлы сохраняются в public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# Только для локального `npm start` (production-сборка без Blob): разрешить запись в
# public/uploads/. На Vercel не включать — там файловая система только для чтения.
# ALLOW_LOCAL_UPLOADS="1"
